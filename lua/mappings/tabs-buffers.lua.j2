local map = vim.keymap.set

map("n", "<leader>X", ":tabclose<CR>", { desc = "Close current tab (keeps buffers)" })

map("n", "<leader>B", ":tabnew %<CR>", { desc = "Open current buffer window in new tab" })
map("n", "<leader>T", ":tabnew<CR>", { desc = "Open new tab" })

map("n", "<F4>", ":%bd|e#<CR>", { desc = "Close all buffers except current" })

-- TODO shorcut close all windows except :only the editor ones
-- map({ "n", "i", "v" }, "<C-s>", "<cmd> w <cr>")

{# quicktabs: Alt+N -> go to tab N (instead of repeating gT/gt), Alt+g -> new
   tab + Dashboard. Two gates so the feature can be turned off at build time OR
   toggled at runtime without rebuilding:
     1. build-time j2 gate: features.quicktabs (default 'true'). When 'false'
        the whole block below is stripped by render_jinja_tree.
     2. runtime lua gate: `quicktabs` var (default true). Flip to false in this
        file to disable the Alt mappings while keeping the leader ones. #}
{%- if features.quicktabs | default('true') == 'true' %}
local quicktabs = true
if quicktabs then
  for i = 1, 9 do
    map("n", "<A-" .. i .. ">", i .. "gt", { desc = "Go to tab " .. i })
    -- Alt+Shift+number: alternative that bypasses outer tmux-wm (which binds
    -- plain Alt+number for pane/tab switching) so tab jumps work even inside
    -- tmux-wm where Alt is captured. Both variants live side-by-side.
    map("n", "<A-S-" .. i .. ">", i .. "gt", { desc = "Go to tab " .. i .. " (Alt+Shift)" })
    map("n", "<M-S-" .. i .. ">", i .. "gt", { desc = "Go to tab " .. i .. " (Alt+Shift)" })
  end
  -- Alt+Shift symbols (what some terminals actually send for Alt+Shift+number,
  -- e.g. Alt+Shift+1 -> Alt+! ). Cover both A and M variants.
  local shift_symbols = { "!", "@", "#", "$", "%", "^", "&", "*", "(" }
  for i, sym in ipairs(shift_symbols) do
    map("n", "<A-" .. sym .. ">", i .. "gt", { desc = "Go to tab " .. i .. " (Alt+Shift symbol)" })
    map("n", "<M-" .. sym .. ">", i .. "gt", { desc = "Go to tab " .. i .. " (Alt+Shift symbol)" })
  end
  map("n", "<A-g>", ":tabnew<CR>:Dashboard<CR>", { desc = "New tab + Dashboard" })
  map("n", "<A-S-g>", ":tabnew<CR>:Dashboard<CR>", { desc = "New tab + Dashboard (Alt+Shift)" })
  map("n", "<M-S-g>", ":tabnew<CR>:Dashboard<CR>", { desc = "New tab + Dashboard (Alt+Shift)" })
  map("n", "<A-G>", ":tabnew<CR>:Dashboard<CR>", { desc = "New tab + Dashboard (Alt+Shift symbol)" })
  map("n", "<M-G>", ":tabnew<CR>:Dashboard<CR>", { desc = "New tab + Dashboard (Alt+Shift symbol)" })

  -- Per-tab project cwd. Opening a project (dashboard, :cd, session restore)
  -- sets the GLOBAL cwd: without this, jumping tabs leaves every tab on the
  -- LATEST opened project (statusline, terminals, agent@sessions all follow
  -- it). Record cwd changes (:cd/:tcd/:lcd — DirChanged) onto the tab they
  -- happen in, and restore that tab's own project when entering it.
  --
  -- Storage is a tabpage var (nvim_tabpage_{get,set}_var), NOT a Lua table
  -- keyed by tab handle: handle userdata does not compare equal across event
  -- loop ticks, so a deferred record/lookup with `handle ~= t` silently missed
  -- every time and tabs got reverted to stale entries (e.g. gwg workspace
  -- switches flipped back). Nvim resolves the handle in C — immune to that.
  local PROJ_VAR = "quicktabs_proj_cwd"

  local function tab_set_cwd(t, dir)
    pcall(vim.api.nvim_tabpage_set_var, t, PROJ_VAR, dir)
  end

  local function tab_get_cwd(t)
    local ok, v = pcall(vim.api.nvim_tabpage_get_var, t, PROJ_VAR)
    if ok and v ~= "" then return v end
    return nil
  end

  local function record_cwd()
    local ok, t = pcall(vim.api.nvim_get_current_tabpage)
    if ok and t then
      tab_set_cwd(t, vim.fn.getcwd())
    end
  end

  vim.api.nvim_create_autocmd("DirChanged", {
    -- NOTE: no scope filter. :tcd fires with scope "tabpage" (not "tab"), so
    -- filtering {"global","tab","window"} silently drops every workspace
    -- switch — which is exactly what this must record.
    pattern = { "*" },
    callback = function()
      local t = vim.api.nvim_get_current_tabpage()
      local tn = vim.fn.tabpagenr()
      local ev_cwd = vim.v.event.cwd
      -- Defer the record: entering/leaving a tcd'd tab fires DirChanged
      -- BEFORE TabEnter's restore (a switch side effect whose cwd equals the
      -- GLOBAL dir, not the entered tab's project). One schedule later a
      -- real :cd still matches; a side effect got overridden by the restore
      -- and no longer matches -> skipped. Guard compares tab NUMBERS (plain
      -- ints): tab handles do not compare equal across ticks.
      vim.schedule(function()
        if vim.fn.tabpagenr() ~= tn then return end
        if vim.fn.getcwd() ~= ev_cwd then return end
        tab_set_cwd(t, ev_cwd)
      end)
    end,
  })
  -- Initialize on enter (startup tab / tabs created before any change) so the
  -- launch project is captured without an explicit :cd.
  vim.api.nvim_create_autocmd("TabEnter", {
    callback = function()
      local t = vim.api.nvim_get_current_tabpage()
      local want = tab_get_cwd(t)
      if want == nil then
        record_cwd()
        return
      end
      if vim.fn.getcwd() ~= want then
        vim.cmd("tcd " .. vim.fn.fnameescape(want))
      end
    end,
  })
  -- No TabClosed cleanup needed: tabpage vars die with their tab, so no stale
  -- entries can haunt reused handles/numbers.
  record_cwd()
end
{% endif %}
