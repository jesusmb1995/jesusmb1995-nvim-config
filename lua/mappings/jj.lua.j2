-- gF: move current buffer's file diff ( @ vs parent ) to another change — picker for destination
map("n", "<leader>gF", function()
  local buf = vim.api.nvim_get_current_buf()
  local file = vim.api.nvim_buf_get_name(buf)
  if file == "" then
    vim.notify("No file in current buffer", vim.log.levels.WARN)
    return
  end
  _with_jj_repo(function()
    require("lazy").load({ plugins = { "jj.nvim" } })
    local runner = require("jj.core.runner")
    local jj_root = _find_jj_root() or vim.fn.getcwd()
    local rel = file
    if vim.startswith(file, jj_root .. "/") then
      rel = file:sub(#jj_root + 2)
    else
      rel = vim.fn.fnamemodify(file, ":.")
    end
    if rel == "" then
      vim.notify("Cannot determine file path relative to jj root", vim.log.levels.WARN)
      return
    end
    -- Quick check: is file modified in @ ? (warn but still allow)
    local diff_check = runner.execute_command("jj diff --name-only -r @ 2>/dev/null", nil, nil, true)
    if diff_check and diff_check ~= "" and not diff_check:match(vim.pesc(rel)) then
      -- file not in diff vs parent; check vs @- then? just notify
      vim.notify("File '" .. rel .. "' not modified in @ (no diff vs parent) — squash will be no-op if empty", vim.log.levels.WARN)
    end
    -- List candidate destinations: previous commits (not just mutable). User sees previous commits but mutable() can be empty; also large files (grammars) cause snapshot refusal without --ignore-working-copy.
    -- Try ancestors first (most relevant), fallback to mutable.
    local out = runner.execute_command("jj log --ignore-working-copy -r 'ancestors(@, 20) ~ @' --no-graph -T 'change_id.shortest(8) ++ \"\\t\" ++ commit_id.shortest(8) ++ \"\\t\" ++ if(bookmarks, bookmarks.map(|b| b.name()).join(\",\"), \"\") ++ \"\\t\" ++ description.first_line()' 2>/dev/null", nil, nil, true)
    if not out or vim.trim(out) == "" then
      out = runner.execute_command("jj log --ignore-working-copy -r 'mutable() & ~@' --no-graph -T 'change_id.shortest(8) ++ \"\\t\" ++ commit_id.shortest(8) ++ \"\\t\" ++ if(bookmarks, bookmarks.map(|b| b.name()).join(\",\"), \"\") ++ \"\\t\" ++ description.first_line()' 2>/dev/null", nil, nil, true)
    end
    if not out or vim.trim(out) == "" then
      vim.notify("No destinations found (no ancestors besides @)", vim.log.levels.WARN)
      return
    end
    local items = {}
    for _, line in ipairs(vim.split(out, "\n")) do
      line = vim.trim(line)
      if line ~= "" then
        local parts = vim.split(line, "\t")
        local change = parts[1] or ""
        local commit = parts[2] or ""
        local bms = parts[3] or ""
        local desc = parts[4] or ""
        local label = change .. " " .. (bms ~= "" and ("[" .. bms .. "] ") or "") .. desc
        if label:match("^%s*$") then label = change end
        table.insert(items, { rev = change, label = label, commit = commit, bms = bms, desc = desc })
      end
    end
    if #items == 0 then
      vim.notify("No destinations to move to", vim.log.levels.WARN)
      return
    end
    vim.ui.select(items, {
      prompt = "Move '" .. rel .. "' diff to revision:",
      format_item = function(item) return item.label end,
    }, function(choice)
      _jj_in_root(jj_root, function()
      if not choice then return end
      local dest = vim.trim(choice.rev)
      -- Use jj squash --from @ --into <dest> -- <file>
      local cmd = "jj squash --from @ --into " .. vim.fn.shellescape(dest) .. " -- " .. vim.fn.shellescape(rel)
      runner.execute_command_async(cmd, function()
        _jj_in_root(jj_root, function()
        require("jj.utils").notify("Moved '" .. rel .. "' changes from @ into " .. dest, vim.log.levels.INFO)
        if require("jj.ui.terminal").is_log_buffer_open() then
          require("jj.cmd").log({})
        end
        end)
      end, "Error moving file to " .. dest)
      end)
    end)
  end)
end, { desc = "jj: move current file diff (@) into selected revision (--from @ --into <pick> -- <file>)" })

map("n", "<leader>gbS", function()
  _with_jj_repo(function()
  local jj_root_cap = _find_jj_root() or vim.fn.getcwd()
