-- Gd: pick FROM then TO (like multi-select D in <leader>gl log) → diffview tab.
-- FROM excludes @ (diff @..@ would be empty); TO defaults to @ first.
map("n", "<leader>Gd", function()
  local gd_root = _find_jj_root() or vim.fn.getcwd()
  _with_jj_repo(function()
    require("lazy").load({ plugins = { "jj.nvim" } })
    local runner = require("jj.core.runner")
    local out = runner.execute_command("jj log --ignore-working-copy -r 'ancestors(@, 20) ~ @' --no-graph -T 'change_id.shortest(8) ++ \"\\t\" ++ commit_id.shortest(8) ++ \"\\t\" ++ description.first_line()' 2>/dev/null", nil, nil, true) or ""
    local items = {}
    for _, line in ipairs(vim.split(out, "\n")) do
      line = vim.trim(line)
      if line ~= "" then
        local cid, desc = line:match("^([^\t]+)\t([^\t]*)")
        table.insert(items, { rev = cid, label = cid .. " " .. (desc or "") })
      end
    end
    if #items == 0 then vim.notify("No previous history besides @", vim.log.levels.WARN) return end
    vim.ui.select(items, { prompt = "Diff FROM (older):", format_item = function(i) return i.label end }, function(from_choice)
      if not from_choice then return end
      local from = vim.trim(from_choice.rev)
      local to_items = { { rev = "@", label = "@ (current)" } }
      for _, it in ipairs(items) do table.insert(to_items, it) end
      vim.ui.select(to_items, { prompt = "Diff TO (newer):", format_item = function(i) return i.label end }, function(to_choice)
        _jj_in_root(gd_root, function()
        if not to_choice then return end
        local to = vim.trim(to_choice.rev)
        if from == to then vim.notify("FROM == TO, empty diff", vim.log.levels.WARN) return end
        _jj_in_root(gd_root, function()
          require("lazy").load({ plugins = { "jj.nvim" } })
          -- Same view as multi-select D in <leader>gl log: diffview in a new tab.
          require("jj.diff").diff_revisions({ left = from, right = to })
        end)
        end)
      end)
    end)
  end)
end, { desc = "jj diff FROM..TO (pick both, diffview tab)" })

-- GD: op log diff --from-op / --to-op with grouping and bookmark names
map("n", "<leader>GD", function()
  local gd2_root = _find_jj_root() or vim.fn.getcwd()
  _with_jj_repo(function()
    require("lazy").load({ plugins = { "jj.nvim" } })
    local runner = require("jj.core.runner")
    local out = runner.execute_command("jj op log --no-graph -T 'id.short(8) ++ \"\\t\" ++ time ++ \"\\t\" ++ description.first_line() ++ \"\\n\"' 2>/dev/null", nil, nil, true) or ""
    -- fallback to plain op log (no time column)
    if vim.trim(out) == "" then out = runner.execute_command("jj op log 2>&1 | head -n 50", nil, nil, true) or "" end
    local ops = {}
    for _, line in ipairs(vim.split(out, "\n")) do
      line = vim.trim(line)
      if line ~= "" then
        local id, time, desc = line:match("^([^\t]+)\t([^\t]+)\t([^\t]*)")
        if not id then id = line:match("^(%S+)"); desc = line:sub(#id+1) end
        table.insert(ops, { id = id, label = id .. "  " .. (time or "") .. "  " .. (desc or "") })
      end
    end
    if #ops == 0 then vim.notify("No operations", vim.log.levels.WARN) return end
    -- grouping: first 5 individually, then group by 2, then 3...
    local grouped = {}
    for i = 1, math.min(5, #ops) do table.insert(grouped, ops[i]) end
    local idx = 6
    local group_size = 2
    while idx <= #ops do
      local chunk = {}
      for j = 0, group_size -1 do if ops[idx+j] then table.insert(chunk, ops[idx+j]) end end
      if #chunk > 0 then
        local label = "group " .. idx .. "-" .. (idx+#chunk-1) .. " (" .. chunk[1].id .. " .. " .. chunk[#chunk].id .. ")"
        table.insert(grouped, { id = chunk[1].id, label = label, is_group = true })
      end
      idx = idx + group_size
      group_size = group_size + 1
      if group_size > 3 then group_size = 3 end
    end
    -- enrich with bookmark names from gkc (without number postfix) sorted by date: add bookmarks to labels
    local bms = runner.execute_command("jj bookmark list -T 'name ++ \"\\n\"' 2>/dev/null", nil, nil, true) or ""
    local bm_set = {}
    for _, b in ipairs(vim.split(bms, "\n")) do b = vim.trim(b):gsub("%d+$",""); if b~="" then bm_set[b]=true end end
    for _, g in ipairs(grouped) do
      for bm,_ in pairs(bm_set) do if g.label:find(bm) then g.label = g.label .. " [" .. bm .. "]" end end
    end
    vim.ui.select(grouped, { prompt = "Diff --from-op (op log):", format_item = function(i) return i.label end }, function(choice)
      _jj_in_root(gd2_root, function()
      if not choice then return end
      local from = vim.trim(choice.id)
      _jj_in_root(gd2_root, function()
        -- Resolve the working-copy commit at that op, then DiffView like <leader>gd.
        -- `jj diff --from-op` is invalid; commit diff C1..C2 is the DiffViewable form.
        local c1 = vim.trim(runner.execute_command("jj --at-operation " .. vim.fn.shellescape(from) .. " log --ignore-working-copy -r @ --no-graph -T 'commit_id.shortest(12)' 2>/dev/null", nil, nil, true) or "")
        local c2 = vim.trim(runner.execute_command("jj log --ignore-working-copy -r @ --no-graph -T 'commit_id.shortest(12)' 2>/dev/null", nil, nil, true) or "")
        if c1 == "" or c2 == "" then
          vim.notify("Could not resolve commits for op diff", vim.log.levels.WARN)
          return
        end
        if c1 == c2 then
          -- Meta-only op (no commit changes): DiffView would be empty, show raw op diff in tab instead.
          vim.cmd("tabnew")
          vim.fn.termopen({ "jj", "op", "diff", "--from", from, "--to", "@" }, { cwd = gd2_root })
          vim.cmd("startinsert")
          pcall(vim.api.nvim_buf_set_name, 0, "jj-op-diff://" .. from)
          return
        end
        require("lazy").load({ plugins = { "jj.nvim" } })
        require("jj.diff").diff_revisions({ left = c1, right = c2 })
      end)
      end)
    end)
  end)
end, { desc = "jj op diff --from (grouped) --to @ (diffview tab)" })
