-- Mason is OFF by default. NvChad's bundled spec
-- (lazy/NvChad/lua/nvchad/plugins/init.lua) enables mason-org/mason.nvim, so
-- returning {} here does NOT disable it -- NvChad's spec wins and :Mason loads.
-- Instead we override that spec with enabled = false: lazy never loads mason,
-- and the prefetch (generate_nvim.lua) drops it from the clone set and prunes
-- any stale lazy/mason.nvim. LSP servers are enabled via vim.lsp.config /
-- vim.lsp.enable (configs/lspconfig.lua.j2) and installed via apt, and the
-- prefetch installs NO mason packages, so mason has nothing to manage. Opt in
-- per config with the nvim repo feature `mason: "true"`.
{% set ns = namespace(enable=false) -%}
{% for repo in repositories -%}
{% if repo.id == "nvim" and repo.features and repo.features.mason == "true" -%}
{% set ns.enable = true -%}
{% endif -%}
{% endfor -%}
{% if ns.enable %}
return {
  "mason-org/mason.nvim",
  opts = {
    automatic_installation = false,
    ui = { check_outdated_packages_on_open = false },
  },
  config = function(_, opts)
    dofile(vim.g.base46_cache .. "mason")
    require("mason").setup(opts)
    local warn = function(name)
      vim.notify("[locked] " .. name .. " disabled — packages are pre-installed", vim.log.levels.WARN)
    end
    vim.api.nvim_create_user_command("MasonInstall", function() warn("MasonInstall") end, { force = true })
    vim.api.nvim_create_user_command("MasonUninstall", function() warn("MasonUninstall") end, { force = true })
    vim.api.nvim_create_user_command("MasonUpdate", function() warn("MasonUpdate") end, { force = true })
  end,
}
{% else %}
return { "mason-org/mason.nvim", enabled = false }
{% endif %}
