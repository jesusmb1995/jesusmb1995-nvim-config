-- gkc: jj duplicate (branch clone) — auto-increment bookmark name
map("n", "<leader>gkc", function()
  _with_jj_repo(function()
  local jj_root_cap = _find_jj_root() or vim.fn.getcwd()
    require("lazy").load({ plugins = { "jj.nvim" } })
    local runner = require("jj.core.runner")
    local utils = require("jj.utils")
    local cur_bm = _get_current_bookmark(runner) or ""
    local desc = runner.execute_command("jj log --ignore-working-copy -r @ --no-graph -T 'description.first_line()' 2>/dev/null", nil, nil, true) or ""
    desc = vim.trim(desc)
    local function random_letters(n)
      local s = ""
      for i = 1, n do s = s .. string.char(math.random(97, 122)) end
      return s
    end
    local function suggest_name()
      if cur_bm ~= "" then
        local base, num = cur_bm:match("^(.-)(%d+)$")
        if base and num then
          return base .. (tonumber(num) + 1)
        else
          return cur_bm .. "2"
        end
      else
        -- No bookmark: original becomes N=1, duplicate N>=2, so numbers go up.
        -- Suggest N=2 (the duplicate's name shown in the dialogue).
        if desc ~= "" then
          local words = {}
          for w in desc:gmatch("%S+") do table.insert(words, w); if #words >= 4 then break end end
          if #words > 0 then
            local j = table.concat(words, "_"):gsub("%W", "_"):lower():sub(1, 30)
            if #j >= 3 then return j .. "2" end
          end
        end
        return random_letters(4) .. "2"
      end
    end
    local suggested = suggest_name()
    vim.ui.input({ prompt = "New bookmark (duplicate @): ", default = suggested }, function(input)
      _jj_in_root(jj_root_cap, function()
      if not input or vim.trim(input) == "" then vim.notify("Aborted", vim.log.levels.WARN) return end
      local new_name = vim.trim(input)
      -- Branch-clone pair: namings must match except number postfix (see GD).
      -- Stack with bookmark: original keeps it, duplicate gets new_name.
      -- Stack with NO bookmark: original @ also needs the base name, else only
      -- one bookmark exists and the pair is broken.
      local dup_name = new_name
      local orig_name = nil
      if cur_bm == "" then
        -- Original is always N=1, duplicates N>=2 and increasing.
        local base = new_name:match("^(.-)%d+$") or new_name
        if base == "" then base = new_name end
        orig_name = base .. "1"
        if not new_name:match("%d+$") then
          dup_name = base .. "2"
        end
        if dup_name == orig_name then
          dup_name = base .. "2"
        end
      end
      -- duplicate whole stack until first immutable (not just @). User saw empty patches when only @ was duplicated.
      -- `ancestors(@) & mutable()` is the mutable stack; `trunk()` is immutable root.
      local dup_revset = "ancestors(@) & mutable()"
      local out = runner.execute_command("jj duplicate --ignore-working-copy -r '" .. dup_revset .. "' 2>&1", nil, nil, true) or ""
      -- `jj duplicate` prints e.g. `Duplicated <old> as <new> ...` per duplicated commit; for a stack, last `as <id>` is the tip (duplicate of @)
      local new_change = nil
      for m in out:gmatch("as%s+(%S+)") do new_change = m end
      if not new_change then new_change = out:match("(%w+)%s+%S*%s*$") end
      -- fallback for stack: find duplicate tip that shares @'s description but is not @
      if not new_change or #new_change < 4 then
        local at = vim.trim(runner.execute_command("jj log --ignore-working-copy -r @ --no-graph -T 'change_id.shortest(8)' 2>/dev/null", nil, nil, true) or "")
        local at_desc = vim.trim(desc)
        if at_desc ~= "" then
          local esc = at_desc:gsub("'", "'\\''")
          local cand = runner.execute_command("jj log --ignore-working-copy -r 'all() & description(exact:" .. vim.fn.shellescape(esc) .. ")' --no-graph -T 'change_id.shortest(8) ++ \"\\n\"' 2>/dev/null", nil, nil, true) or ""
          for _, cid in ipairs(vim.split(cand, "\n")) do
            cid = vim.trim(cid)
            if cid ~= "" and cid ~= at then new_change = cid; break end
          end
        end
        if not new_change then
          local children = runner.execute_command("jj log --ignore-working-copy -r 'children(@-)' --no-graph -T 'change_id.shortest(8) ++ \"\\n\"' 2>/dev/null", nil, nil, true) or ""
          for _, cid in ipairs(vim.split(children, "\n")) do
            cid = vim.trim(cid)
            if cid ~= "" and cid ~= at then new_change = cid; break end
          end
        end
      end
      if not new_change or new_change == "" then
        vim.notify("Duplicate succeeded but could not find new change id", vim.log.levels.WARN)
        return
      end
      if orig_name then
        -- best effort: name the original so the pair exists even if dup fails
        runner.execute_command("jj bookmark create --ignore-working-copy " .. vim.fn.shellescape(orig_name) .. " -r @ 2>/dev/null", nil, nil, true)
      end
      runner.execute_command_async("jj bookmark create --ignore-working-copy " .. vim.fn.shellescape(dup_name) .. " -r " .. vim.fn.shellescape(new_change), function()
        _jj_in_root(jj_root_cap, function()
        if orig_name then
          utils.notify("Cloned stack: " .. orig_name .. " (original @) + " .. dup_name .. " (duplicate " .. new_change .. ")", vim.log.levels.INFO)
        else
          utils.notify("Duplicated @ as " .. new_change .. " with bookmark " .. dup_name, vim.log.levels.INFO)
        end
        if require("jj.ui.terminal").is_log_buffer_open() then require("jj.cmd").log({}) end
        end)
      end, "Error creating bookmark on duplicate")
      end)
    end)
  end)
end, { desc = "jj duplicate stack → bookmark pair (auto-increment)" })

-- gw* helpers: jj workspace list parsing. NOTE: <leader>gwg itself lives in
-- mappings.git-worktrees (loaded after this file, wins the duplicate) with full
-- jj-shadowing; do NOT define gwg here or the two fight.
-- `jj workspace list` prints "<name>: <path> <change> <desc...>" plus possible
-- status lines (e.g. "Rebased N descendants..."). Path is the FIRST token after
-- "name: "; everything after is change/desc junk. Lines without "name:" are skipped.
local function _jj_workspace_list()
  local runner = require("jj.core.runner")
  local out = runner.execute_command("jj workspace list 2>/dev/null", nil, nil, true) or ""
  local list = {}
  for _, line in ipairs(vim.split(out, "\n")) do
    line = vim.trim(line)
    if line ~= "" then
      local name, rest = line:match("^(%S+):%s*(.+)$")
      if name and rest then
        local path = rest:match("^(%S+)")
        if path then table.insert(list, { name = name, path = path, label = line }) end
      end
    end
  end
  return list
end
local function _is_jj_repo() return _find_jj_root() ~= nil end

map("n", "<leader>gwa", function()
  _with_jj_repo(function()
  local jj_root_cap = _find_jj_root() or vim.fn.getcwd()
    require("lazy").load({ plugins = { "jj.nvim" } })
    vim.ui.input({ prompt = "New workspace name: " }, function(name)
      _jj_in_root(jj_root_cap, function()
      if not name or vim.trim(name) == "" then return end
      name = vim.trim(name)
      vim.ui.input({ prompt = "Workspace path (empty = ../<name>): " }, function(path)
        _jj_in_root(jj_root_cap, function()
        if path ~= nil then
          path = vim.trim(path)
          if path == "" then path = "../" .. name end
          local runner = require("jj.core.runner")
          runner.execute_command_async("jj workspace add --name " .. vim.fn.shellescape(name) .. " " .. vim.fn.shellescape(path), function()
            _jj_in_root(jj_root_cap, function()
            require("jj.utils").notify("Added workspace " .. name .. " at " .. path, vim.log.levels.INFO)
            end)
          end, "Error adding workspace")
        end
        end)
      end)
      end)
    end)
  end)
end, { desc = "jj workspace add" })

